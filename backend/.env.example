# Copy to backend/.env and fill in. Never commit .env.
# On Render, set these same names as environment variables instead of using a file.

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Optional fallback LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- MongoDB (database "insight-ai" holds users, datasets, conversations) ---
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#         (URL-encode special characters in the password, e.g. @ -> %40)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=insight-ai

# Long random string used to sign login tokens (python -c "import secrets;print(secrets.token_hex(32))").
# Must be set in production, otherwise every restart logs all users out.
JWT_SECRET=

# --- CORS (only needed once the frontend is deployed) ---
# Your Vercel URL, comma-separated, no trailing slash. localhost always works for development.
CORS_ORIGINS=
# Optional: also allow Vercel preview deployments, e.g. https://insightai(-.*)?\.vercel\.app
CORS_ORIGIN_REGEX=
